{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mycore",
  "version-string": "0.1.0",
  "dependencies": [
    "catch2",
    {
      "name": "directx-dxc",
      "host": true,
      "platform": "windows"
    },
    {
      "name": "glslang",
      "features": ["tools"],
      "host": true,
      "platform": "osx | linux"
    },
    "fmt",
    {
      "name": "gamenetworkingsockets",
      "default-features": false
    },
    {
      "name": "imgui",
      "features": ["sdlgpu3-binding"]
    },
    "sdl3",
    "spdlog",
    {
      "name": "spirv-cross",
      "host": true,
      "platform": "osx"
    },
    "tomlplusplus",
    {
      "name": "tracy",
      "features": ["on-demand"]
    }
  ]
}
